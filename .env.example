# Local/CI environment template for the Project Eryx Bun API.
# Copy to .env and fill real values. Never commit real keys.

# Supabase fleet project (public HTTP gateway; no raw Postgres connection).
SUPABASE_URL=https://supabase.shrijit.tech/rjrynmjugsxuytpotfma
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# HTTP bind / health
HOST=0.0.0.0
PORT=8080
APP_VERSION=dev

# Redis (market data + rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional tunables
TRIGGER_MS=3000
RECONCILE_MS=900000
AGENT_RATE_LIMIT=60
MARKET_HOURS_REQUIRED=false
