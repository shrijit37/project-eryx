{
  "name": "project-eryx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "db:seed": "turbo run db:seed",
    "db:reset": "turbo run db:reset",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "dotenv": "^17.4.2",
    "turbo": "^2.5.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.11.1",
    "yfinance-ts": "^0.3.0",
    "zod": "^4.4.3"
  }
}
