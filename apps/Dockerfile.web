# Next.js web app for Project Eryx. NEXT_PUBLIC_* are inlined at build time,
# so they must be passed as build args.
FROM oven/bun:1.3.14-alpine AS base

WORKDIR /app

COPY package.json bun.lock* turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/ws-gateway/package.json apps/ws-gateway/
COPY apps/candle-worker/package.json apps/candle-worker/
COPY apps/market-data-worker/package.json apps/market-data-worker/
COPY apps/web/package.json apps/web/
COPY packages/ packages/

RUN bun install --frozen-lockfile 2>/dev/null || bun install

ARG NEXT_PUBLIC_API_URL=https://api.eryx.triptribe.info
ARG NEXT_PUBLIC_WS_URL=https://api.eryx.triptribe.info
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_eryx?schema=public
RUN cd packages/db && bunx prisma generate

COPY . .

# Build only the web app (avoids building the Bun services)
RUN cd apps/web && bun run build

# Bind loopback so it is only reachable via nginx (host networking)
CMD ["bun", "node_modules/next/dist/bin/next", "start", "-p", "3008", "-H", "127.0.0.1"]
