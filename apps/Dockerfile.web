# Project Eryx web (Next.js dashboard). Built ONLY in GitHub Actions and
# pushed to GHCR; Dokploy pulls by SHA tag. NEXT_PUBLIC_* are inlined at
# build time, so they arrive as build args from CI (canonical domains:
# https://api.project-eryx.shrijit.tech, wss via the same host).
FROM oven/bun:1.4-alpine AS base

WORKDIR /app

COPY package.json bun.lock* turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/ws-gateway/package.json apps/ws-gateway/
COPY apps/candle-worker/package.json apps/candle-worker/
COPY apps/market-data-worker/package.json apps/market-data-worker/
COPY apps/web/package.json apps/web/
COPY packages/ packages/

RUN bun install --frozen-lockfile

ARG NEXT_PUBLIC_API_URL=https://api.project-eryx.shrijit.tech
ARG NEXT_PUBLIC_WS_URL=wss://ws.project-eryx.shrijit.tech
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_eryx?schema=public
RUN cd packages/db && bunx prisma generate

COPY . .

# Build only the web app (avoids building the Bun services)
RUN cd apps/web && bun run build

# next is hoisted into apps/web/node_modules (not root), so run via the app dir.
CMD ["sh", "-c", "cd apps/web && bun run start -p 3008 -H 0.0.0.0"]
