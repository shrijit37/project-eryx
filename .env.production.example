# Production environment template (server-side only — never commit real values).
# The CI/CD deploy copies nothing here; the server's `/home/ubuntu/projects/eryx/.env`
# is created manually once during provisioning.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_eryx?schema=public
JWT_SECRET=change-me
PORT=8080
WS_PORT=4040
FINNHUB_API=
TRIGGER_MS=3000
RECONCILE_MS=900000
