# Production environment template (server-side only — never commit real values).
# Values are set on the Coolify dockerimage app (and in the dotenvx-encrypted
# .env.production). Database/auth go through the Supabase HTTP gateway; the
# API does NOT open a raw Postgres connection.

SUPABASE_URL=https://supabase.shrijit.tech/rjrynmjugsxuytpotfma
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy/unused (kept only for other local tooling): DATABASE_URL is no longer
# read by apps/api. Redis is still required for market data and rate limiting.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/project_eryx?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_URL=https://auth.shrijit.tech
HOST=0.0.0.0
PORT=8080
WS_PORT=4040
FINNHUB_API=
TRIGGER_MS=3000
RECONCILE_MS=900000
